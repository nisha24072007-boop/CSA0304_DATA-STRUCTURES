#include <stdio.h>
#include <stdlib.h>

#define T 2

typedef struct B {
    int n, leaf, k[3];
    struct B *c[4];
} B;

B *node(int leaf) {
    B *x = calloc(1, sizeof(B));
    if (!x) exit(1);
    x->leaf = leaf;
    return x;
}

B *search(B *x, int k) {
    if (!x) return NULL;

    int i = 0;
    while (i < x->n && k > x->k[i])
        i++;

    if (i < x->n && k == x->k[i])
        return x;

    return x->leaf ? NULL : search(x->c[i], k);
}

void split(B *p, int i, B *y) {
    B *z = node(y->leaf);
    z->n = 1;
    z->k[0] = y->k[2];

    if (!y->leaf) {
        z->c[0] = y->c[2];
        z->c[1] = y->c[3];
    }

    y->n = 1;

    for (int j = p->n; j >= i + 1; j--)
        p->c[j + 1] = p->c[j];

    p->c[i + 1] = z;

    for (int j = p->n - 1; j >= i; j--)
        p->k[j + 1] = p->k[j];

    p->k[i] = y->k[1];
    p->n++;
}

void nonfull(B *x, int k) {
    int i = x->n - 1;

    if (x->leaf) {
        while (i >= 0 && k < x->k[i]) {
            x->k[i + 1] = x->k[i];
            i--;
        }

        x->k[i + 1] = k;
        x->n++;
    } else {
        while (i >= 0 && k < x->k[i])
            i--;

        i++;

        if (x->c[i]->n == 3) {
            split(x, i, x->c[i]);

            if (k > x->k[i])
                i++;
        }

        nonfull(x->c[i], k);
    }
}

B *insert(B *r, int k) {
    if (!r) {
        r = node(1);
        r->k[0] = k;
        r->n = 1;
        return r;
    }

    if (search(r, k))
        return r;

    if (r->n == 3) {
        B *s = node(0);
        s->c[0] = r;
        split(s, 0, r);

        int i = k > s->k[0];
        nonfull(s->c[i], k);
        return s;
    }

    nonfull(r, k);
    return r;
}

void print(B *x) {
    if (!x) return;

    printf("[");
    for (int i = 0; i < x->n; i++)
        printf("%s%d", i ? "|" : "", x->k[i]);

    printf("] ");

    if (!x->leaf)
        for (int i = 0; i <= x->n; i++)
            print(x->c[i]);
}

void freeT(B *x) {
    if (x) {
        if (!x->leaf)
            for (int i = 0; i <= x->n; i++)
                freeT(x->c[i]);

        free(x);
    }
}

int main(void) {
    int a[] = {10, 20, 5, 6, 12, 30, 7, 17};
    B *r = NULL;

    for (int i = 0; i < 8; i++)
        r = insert(r, a[i]);

    print(r);

    printf("\nSearch 17: %s\n",
           search(r, 17) ? "found" : "not found");

    printf("Search 99: %s\n",
           search(r, 99) ? "found" : "not found");

    freeT(r);
    return 0;
}
