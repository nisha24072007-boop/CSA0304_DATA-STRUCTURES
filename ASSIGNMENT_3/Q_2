#include <stdio.h>
#include <stdlib.h>

typedef struct N {
    int k, h;
    struct N *l, *r;
} N;

int H(N *n) {
    return n ? n->h : 0;
}

int mx(int a, int b) {
    return a > b ? a : b;
}

void fix(N *n) {
    n->h = 1 + mx(H(n->l), H(n->r));
}

N *rr(N *y) {
    N *x = y->l, *t = x->r;
    x->r = y;
    y->l = t;
    fix(y);
    fix(x);
    return x;
}

N *rl(N *x) {
    N *y = x->r, *t = y->l;
    y->l = x;
    x->r = t;
    fix(x);
    fix(y);
    return y;
}

N *ins(N *n, int k) {
    if (!n) {
        n = malloc(sizeof(N));
        n->k = k;
        n->h = 1;
        n->l = n->r = NULL;
        return n;
    }

    if (k < n->k)
        n->l = ins(n->l, k);
    else if (k > n->k)
        n->r = ins(n->r, k);
    else
        return n;

    fix(n);
    int b = H(n->l) - H(n->r);

    if (b > 1 && k < n->l->k)
        return rr(n);

    if (b < -1 && k > n->r->k)
        return rl(n);

    if (b > 1 && k > n->l->k) {
        n->l = rl(n->l);
        return rr(n);
    }

    if (b < -1 && k < n->r->k) {
        n->r = rr(n->r);
        return rl(n);
    }

    return n;
}

void pre(N *n) {
    if (n) {
        printf("%d ", n->k);
        pre(n->l);
        pre(n->r);
    }
}

void freeT(N *n) {
    if (n) {
        freeT(n->l);
        freeT(n->r);
        free(n);
    }
}

int main(void) {
    int a[] = {10, 20, 30, 40, 50, 25};
    N *r = NULL;

    for (int i = 0; i < 6; i++)
        r = ins(r, a[i]);

    printf("Preorder: ");
    pre(r);
    printf("\nHeight = %d\n", H(r));

    freeT(r);
    return 0;
}
